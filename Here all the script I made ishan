local Config     = require(MC_Shared.Config)
local Controller = require(MC_Client.Controller)
local Hands      = require(MC_Client.Hands)
local World      = require(MC_Client.World)
local BLOCK      = Config.BLOCK

local SETTINGS = {
    StepDelay    = 0.1,    -- 2 ticks = 0.1 seconds
    BowHoldTicks = 12,   -- Hold bow ~0.5s for full charge
    EquipTimeout = 30,
    MaxJobTicks  = 120,
}

-- ── Find Queues ────────────────────────────────────────────────────────
local u116_queue, u224_targets, handsIndex = nil, nil, nil
pcall(function()
    for i, fn in ipairs(Controller.beforeTick) do
        if type(fn) == "function" and debug.info(fn, "s"):find("Hands") then
            local ok, q = pcall(debug.getupvalue, fn, 1)
            if ok and type(q) == "table" and q.attacks ~= nil then
                u116_queue = q
                handsIndex = i
                local ok6, af = pcall(debug.getupvalue, fn, 6)
                if ok6 and type(af) == "function" then
                    local okT, tq = pcall(debug.getupvalue, af, 1)
                    if okT and type(tq) == "table" then u224_targets = tq end
                end
                break
            end
        end
    end
end)
if not u116_queue then return end

-- ── Helpers ────────────────────────────────────────────────────────────
local function isAlive()
    local char = LocalPlayer.Character
    return Controller.state ~= nil and char ~= nil and char:GetAttribute("Alive") == true
end

local function findHotbar(id)
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it and it.id == id then return i, it end
    end
    return nil
end

-- Returns block coordinates, NOT world/stud coordinates
local function findPlacementTarget()
    local eye, state = Controller.eye(), Controller.state
    if not eye or not state then return nil end
    local look = Controller.look()
    
    -- 1. Where the crosshair is pointing
    local hit = World.blockRay(eye, look, 4.5, {"Solid"})
    if hit and hit.normal.Y >= 0.5 then
        return hit.cell + Vector3.new(0.5, 1.0, 0.5) 
    end
    
    -- 2. Down at the player's feet
    local origin = state.pos + Vector3.new(0, 0.5, 0)
    local r = World.blockRay(origin, Vector3.new(0, -1, 0), 5, {"Solid"})
    if r and r.normal.Y >= 0.5 then
        return r.cell + Vector3.new(0.5, 1.0, 0.5)
    end
    return nil
end

-- ── Silent Aim (Camera Restore) ────────────────────────────────────────
local savedYaw, savedPitch = nil, nil

local function aimAtBlockPos(blockPt)
    local eye = Controller.eye()
    if not eye or not blockPt then return end
    local dir = blockPt - eye
    if dir.Magnitude > 0.1 then
        local unit = dir.Unit
        if not savedYaw then
            savedYaw, savedPitch = Controller.yaw, Controller.pitch
        end
        Controller.yaw = math.atan2(-unit.X, -unit.Z)
        Controller.pitch = math.asin(math.clamp(unit.Y, -0.999, 0.999))
    end
end

local function restoreView()
    if savedYaw ~= nil and savedPitch ~= nil then
        Controller.yaw = savedYaw
        Controller.pitch = savedPitch
        savedYaw, savedPitch = nil, nil
    end
end

-- ── State Machine ──────────────────────────────────────────────────────
local job = nil

local function stepJob()
    if not job then return end
    if not isAlive() then job = nil; restoreView(); return end
    if Controller.tickCount - job.startTick > SETTINGS.MaxJobTicks then
        job = nil; restoreView(); return
    end

    local elapsed = Controller.tickCount - job.stepStartTick
    if job.waitUntilTick and Controller.tickCount < job.waitUntilTick then
        return
    end

    -------------------------------------------------- 1. EQUIP RAIL
    if job.step == "equipRail" then
        if Hands.inv.selected == job.railSlot then
            job.step = "useRail"
            job.stepStartTick = Controller.tickCount
            job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
            return
        end
        if elapsed >= SETTINGS.EquipTimeout then job = nil; return end
        u116_queue.select  = job.railSlot
        u116_queue.attacks = 0
        return
    end

    -------------------------------------------------- 2. USE RAIL
    if job.step == "useRail" then
        if not job.groundWorld then
            job.groundWorld = findPlacementTarget()
            if not job.groundWorld then job = nil; return end
        end
        aimAtBlockPos(job.groundWorld)
        u116_queue.attacks = 0
        if u224_targets then table.clear(u224_targets) end
        u116_queue.uses = 1
        job.step = "equipCart"
        job.stepStartTick = Controller.tickCount
        job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
        return
    end

    -------------------------------------------------- 3. EQUIP CART
    if job.step == "equipCart" then
        if Hands.inv.selected == job.cartSlot then
            job.step = "useCart"
            job.stepStartTick = Controller.tickCount
            job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
            return
        end
        if elapsed >= SETTINGS.EquipTimeout then job = nil; return end
        u116_queue.select  = job.cartSlot
        u116_queue.attacks = 0
        return
    end

    -------------------------------------------------- 4. USE CART
    if job.step == "useCart" then
        aimAtBlockPos(job.groundWorld)
        u116_queue.attacks = 0
        if u224_targets then table.clear(u224_targets) end
        u116_queue.uses = 1
        job.step = job.useBow and "equipBow" or "equipFlint"
        job.stepStartTick = Controller.tickCount
        job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
        return
    end

    -------------------------------------------------- 5. EQUIP BOW
    if job.step == "equipBow" then
        if Hands.inv.selected == job.bowSlot then
            job.step = "useBow"
            job.stepStartTick = Controller.tickCount
            job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
            return
        end
        if elapsed >= SETTINGS.EquipTimeout then job = nil; return end
        u116_queue.select  = job.bowSlot
        u116_queue.attacks = 0
        return
    end

    -------------------------------------------------- 6. USE BOW
    if job.step == "useBow" then
        -- Aim at the cart (slightly above the rail block)
        aimAtBlockPos(job.groundWorld + Vector3.new(0, 0.3, 0))
        u116_queue.attacks = 0
        if u224_targets then table.clear(u224_targets) end
        u116_queue.uses = 1
        job.step = "holdBow"
        job.bowStartTick = Controller.tickCount
        return
    end

    -------------------------------------------------- 7. HOLD BOW -> RELEASE
    if job.step == "holdBow" then
        -- Keep camera locked until release
        aimAtBlockPos(job.groundWorld + Vector3.new(0, 0.3, 0))
        
        if Controller.tickCount - job.bowStartTick >= SETTINGS.BowHoldTicks then
            if Hands.using then pcall(Hands.stopUsing, false) end
            job.step = "restore"
            job.stepStartTick = Controller.tickCount
            job.waitUntilTick = Controller.tickCount + 1
        end
        return
    end

    -------------------------------------------------- 5b. EQUIP FLINT
    if job.step == "equipFlint" then
        if Hands.inv.selected == job.flintSlot then
            job.step = "useFlint"
            job.stepStartTick = Controller.tickCount
            job.waitUntilTick = Controller.tickCount + SETTINGS.StepDelay
            return
        end
        if elapsed >= SETTINGS.EquipTimeout then job = nil; return end
        u116_queue.select  = job.flintSlot
        u116_queue.attacks = 0
        return
    end

    -------------------------------------------------- 6b. USE FLINT
    if job.step == "useFlint" then
        aimAtBlockPos(job.groundWorld)
        u116_queue.attacks = 0
        if u224_targets then table.clear(u224_targets) end
        u116_queue.uses = 1
        job.step = "restore"
        job.stepStartTick = Controller.tickCount
        job.waitUntilTick = Controller.tickCount + 1
        return
    end

    -------------------------------------------------- 8. RESTORE SLOT
    if job.step == "restore" then
        if Hands.inv.selected ~= job.origSlot then
            u116_queue.select = job.origSlot
        end
        restoreView()
        job = nil
        return
    end
end

if handsIndex then
    table.insert(Controller.beforeTick, handsIndex, stepJob)
else
    table.insert(Controller.beforeTick, 1, stepJob)
end

table.insert(Controller.onTick, restoreView)

