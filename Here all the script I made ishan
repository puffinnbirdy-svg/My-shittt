-- ── State & Config ─────────────────────────────────────────────────────
local Cfg = {
    AutoDestroyCart = false
}

local lastAttackTick = 0

-- ── Helpers ────────────────────────────────────────────────────────────
local function isAlive()
    if Workspace:GetAttribute("JugHold") == true then return false end
    local char = LocalPlayer.Character
    return Controller.state ~= nil and char ~= nil and char:GetAttribute("Alive") == true
end

local function getBestSwordSlot()
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it then
            local def = Items.def(it)
            if def and def.kind == "sword" then
                return i
            end
        end
    end
    return nil
end

local function findNearestCartPivot(eyePos, maxReach)
    local carts = World.folder and World.folder:FindFirstChild("Carts")
    if not carts then return nil, nil end
    local bestCart, bestPt, bestDist = nil, nil, maxReach or 4.5
    for _, c in ipairs(carts:GetChildren()) do
        if c:GetAttribute("CartId") and c:IsA("Model") then
            local pt = (c:GetPivot().Position / BLOCK) + Vector3.new(0, 0.35, 0)
            local d = (pt - eyePos).Magnitude
            if d <= bestDist then
                bestDist = d
                bestCart = c
                bestPt = pt
            end
        end
    end
    return bestCart, bestPt
end

-- ── Main Logic ─────────────────────────────────────────────────────────
local statusLbl

local function stepAutoDestroyCart()
    if not Cfg.AutoDestroyCart or not isAlive() then return end

    local eye = Controller.eye()
    if not eye then return end

    -- Look for a cart within 4.5 blocks
    local cart, cartPt = findNearestCartPivot(eye, 4.5)
    
    if cartPt then
        -- 1. Hard Lock Camera to the Cart
        local delta = cartPt - eye
        if delta.Magnitude > 0.1 then
            local unit = delta.Unit
            Controller.yaw = math.atan2(-unit.X, -unit.Z)
            Controller.pitch = math.asin(math.clamp(unit.Y, -0.999, 0.999))
        end

        -- 2. Ensure we hold a Sword
        local swSlot = getBestSwordSlot()
        if swSlot and Hands.inv.selected ~= swSlot then
            u116_queue.select = swSlot
        end

        -- 3. Swing (4 tick cooldown)
        if Controller.tickCount - lastAttackTick >= 4 then
            lastAttackTick = Controller.tickCount
            if u224_targets then table.clear(u224_targets) end
            u116_queue.attacks = 1
            if statusLbl then statusLbl.Text = "Destroying Cart!" end
        end
    else
        -- No cart found: Do absolutely nothing. 
        -- This lets your manual mouse clicks pass through to the game normally.
        if statusLbl and Cfg.AutoDestroyCart then 
            statusLbl.Text = "Searching..." 
        end
    end
end

-- Insert right before Hands so it overrides inputs
if handsIndex then
    table.insert(Controller.beforeTick, handsIndex, stepAutoDestroyCart)
else
    table.insert(Controller.beforeTick, 1, stepAutoDestroyCart)
end

