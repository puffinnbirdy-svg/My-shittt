-- Standalone Sword -> Breach Mace -> Sword Swap
local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer   = Players.LocalPlayer
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
local MC_Client     = PlayerScripts:WaitForChild("MC")
local MC_Shared     = ReplicatedStorage:WaitForChild("MC")

local Items      = require(MC_Shared.Items)
local Combat     = require(MC_Shared.Combat)
local Controller = require(MC_Client.Controller)
local Hands      = require(MC_Client.Hands)

-- ── Find Attack Queue & Hands Index ────────────────────────────────────
local u116_queue = nil
local handsIndex = nil

pcall(function()
    for i, fn in ipairs(Controller.beforeTick) do
        if type(fn) == "function" and debug.info(fn, "s"):find("Hands") then
            local ok, q = pcall(debug.getupvalue, fn, 1)
            if ok and type(q) == "table" and q.attacks ~= nil then
                u116_queue = q
                handsIndex = i
                break
            end
        end
    end
end)

if not u116_queue then
    warn("[BreachSwap] Could not find Mourier attack queue. Is the client loaded?")
    return
end

-- ── State & Config ─────────────────────────────────────────────────────
local Cfg = {
    BreachSwap = false,
    MinCharge = 0.85
}

local pendingRestoreSlot = nil
local pendingRestoreTick = 0

-- ── Helpers ────────────────────────────────────────────────────────────
local function isAlive()
    if Workspace:GetAttribute("JugHold") == true then return false end
    local char = LocalPlayer.Character
    return Controller.state ~= nil and char ~= nil and char:GetAttribute("Alive") == true
end

local function getBestBreachMaceSlot()
    local bestSlot, bestScore = nil, -999
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it and it.id == "mace" then
            local breachLvl = Items.ench(it, "breach") or 0
            if breachLvl > 0 then
                local wbLvl = Items.ench(it, "wind_burst") or 0
                local score = breachLvl * 20 - wbLvl * 5
                if score > bestScore then
                    bestScore = score
                    bestSlot = i
                end
            end
        end
    end
    return bestSlot
end

-- Extracts the actual attack charge using the client's internal tracker
local noteSwapFn = nil
pcall(function()
    local okNs, ns = pcall(debug.getupvalue, Hands.select, 2)
    if okNs and type(ns) == "function" then
        noteSwapFn = ns
    end
end)

local function getEffectiveAttackStrength()
    if noteSwapFn then
        local ok1, u95 = pcall(debug.getupvalue, noteSwapFn, 1)
        local ok3, u96 = pcall(debug.getupvalue, noteSwapFn, 3)
        if ok1 and ok3 and type(u96) == "table" and (Controller.tickCount - (tonumber(u95) or -99)) <= 1 then
            local def = u96.item and Items.def(u96.item)
            return Combat.strength(Controller.tickCount - (u96.reset or 0), def and def.speed or 4)
        end
    end
    return Hands.strength(0)
end

-- ── Main Tick Logic ────────────────────────────────────────────────────
local statusLbl -- Forward declaration for GUI debug

local function stepBreachSwap()
    if not isAlive() then return end

    -- 1. Handle Swapping Back to Sword
    if pendingRestoreSlot and Controller.tickCount >= pendingRestoreTick then
        if not u116_queue.select and Hands.inv.selected ~= pendingRestoreSlot then
            u116_queue.select = pendingRestoreSlot
        end
        pendingRestoreSlot = nil
    end

    -- 2. Handle Detecting Attack & Swapping to Mace
    if Cfg.BreachSwap and u116_queue and (u116_queue.attacks or 0) > 0 then
        if not u116_queue.select then
            local held = Hands.held()
            local heldDef = held and Items.def(held)
            
            if heldDef and heldDef.kind == "sword" then
                local breachSlot = getBestBreachMaceSlot()
                local origSlot = Hands.inv.selected
                
                if breachSlot then
                    if breachSlot ~= origSlot then
                        local charge = getEffectiveAttackStrength()
                        if charge >= Cfg.MinCharge then
                            -- DO THE SWAP
                            u116_queue.select = breachSlot
                            pendingRestoreSlot = origSlot
                            pendingRestoreTick = Controller.tickCount + 1
                            if statusLbl then statusLbl.Text = "Swapping to Mace!" end
                        else
                            if statusLbl then statusLbl.Text = string.format("Low Charge: %.2f", charge) end
                        end
                    else
                        if statusLbl then statusLbl.Text = "Already holding Mace" end
                    end
                else
                    if statusLbl then statusLbl.Text = "No Breach Mace in hotbar" end
                end
            else
                if statusLbl then statusLbl.Text = "Not holding a Sword" end
            end
        end
    else
        if statusLbl and Cfg.BreachSwap then
            statusLbl.Text = "Waiting for attack..."
        end
    end
end

-- Insert right before Hands so it catches the queue
if handsIndex then
    table.insert(Controller.beforeTick, handsIndex, stepBreachSwap)
else
    table.insert(Controller.beforeTick, 1, stepBreachSwap)
end

