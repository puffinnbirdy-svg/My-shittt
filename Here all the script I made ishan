    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- deploy
btn.MouseButton1Click:Connect(function()
    if job then status.Text = "Already running…"; return end
    if not isAlive() then status.Text = "Fail: not alive"; return end

    local railSlot  = findHotbar("rail")
    local cartSlot  = findHotbar("tnt_minecart")
    local bowSlot   = findHotbar("bow")
    local flintSlot = findHotbar("flint_and_steel")

    if not railSlot then status.Text = "Fail: no rail"; return end
    if not cartSlot then status.Text = "Fail: no TNT cart"; return end

    local useBow   = bowSlot ~= nil and Hands.hasItem("arrow")
    local useFlint = flintSlot ~= nil
    if not useBow and not useFlint then
        status.Text = "Fail: no bow+arrow or flint"
        return
    end

    job = {
        step          = "equipRail",
        stepStartTick = Controller.tickCount,
        startTick     = Controller.tickCount,
        railSlot      = railSlot,
        cartSlot      = cartSlot,
        bowSlot       = bowSlot,
        flintSlot     = flintSlot,
        useBow        = useBow,
        origSlot      = Hands.inv.selected,
        groundWorld   = nil,
    }
    status.Text = "Deploying…"
end)

RunService.Heartbeat:Connect(function()
    if job then
        status.Text = "Step: " .. job.step
    elseif status.Text:find("^Step") or status.Text == "Deploying…" then
