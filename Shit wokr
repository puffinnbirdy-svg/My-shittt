--// LOGIC ------------------------------------------------------
local function GetBestTarget()
    local MyChar = LocalPlayer.Character
    local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")
    if not MyRoot then return nil end

    if LockEnabled and LockedTarget and LockedTarget.Character then
        local lRoot = LockedTarget.Character:FindFirstChild("HumanoidRootPart")
        local lHum = LockedTarget.Character:FindFirstChildOfClass("Humanoid")
        if lRoot and lHum and lHum.Health > 0 then
            local dist = (lRoot.Position - MyRoot.Position).Magnitude
            if dist <= LEGIT_REACH then
                return LockedTarget
            end
        end
    end

    local BestTarget = nil
    local ShortestDistance = math.huge
    
    for _, Player in Players:GetPlayers() do
        if Player == LocalPlayer then continue end
        local Character = Player.Character
        if not Character then continue end
        
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end
        
        local TargetRoot = Character:FindFirstChild("HumanoidRootPart")
        if not TargetRoot then continue end
        
        local Distance = (TargetRoot.Position - MyRoot.Position).Magnitude
        if Distance > LEGIT_REACH then continue end
        
        if Distance < ShortestDistance then
            ShortestDistance = Distance
            BestTarget = Player
        end
    end
    return BestTarget
end

--// MAIN INTERNAL LOOP -----------------------------------------
task.spawn(function()
    while task.wait(0.05) do
        local MyChar = LocalPlayer.Character
        local IsSwordEquipped = false
        
        if MyChar then
            for _, item in ipairs(MyChar:GetChildren()) do
                local name = string.lower(item.Name)
                if string.find(name, "netherite") and string.find(name, "sword") then
                    IsSwordEquipped = true; break
                end
            end
        end

        -- Force Stop Logic
        if not IsSwordEquipped then
            if not ForceStopped then
                ForceStopped = true
                ForceStopButton.Text = "Force Stop: ON (Auto)"
                ForceStopButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end
        else
            if ForceStopButton.Text == "Force Stop: ON (Auto)" then
                ForceStopped = false
                ForceStopButton.Text = "Force Stop: OFF"
                ForceStopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            end
        end

        if ForceStopped then
            AutoAttackEnabled = false
            ToggleButton.Text = "Auto Attack: STOPPED"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
        else
            if not AutoAttackEnabled then
                ToggleButton.Text = "Auto Attack: OFF"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 80, 88)
            else
                ToggleButton.Text = "Auto Attack: ON"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 220, 200)
                
                local Target = GetBestTarget()
                if Target then
                    StatusLabel.Text = "Status: Legit Swinging at " .. Target.Name
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 200)
                    
                    -- ✅ FIXED AIM LOGIC: Perfectly snaps to head using CFrame math
                    local myRoot = MyChar.HumanoidRootPart
                    local targetHead = Target.Character:FindFirstChild("Head") or Target.Character.HumanoidRootPart
                    
                    local lookAtCFrame = CFrame.lookAt(myRoot.Position, targetHead.Position)
                    local pitch, yaw, roll = lookAtCFrame:ToEulerAnglesYXZ()
                    
                    ControllerModule.yaw = yaw
                    ControllerModule.pitch = pitch
                    
                    -- Simulate a real mouse click
                    InputModule.setVirtual("attack", true)
                    task.wait(0.05) 
                    InputModule.setVirtual("attack", false)
                    
                    task.wait(BASE_INTERVAL)
                else
                    if LockEnabled then
                        StatusLabel.Text = "Status: Locked Target Out of Reach"
                    else
                        StatusLabel.Text = "Status: Out of Reach"
                    end
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
            end
        end
    end
end)

--// CAMERA LOCK LOOP -------------------------------------------
RunService.RenderStepped:Connect(function()
    if LockEnabled and LockedTarget and LockedTarget.Character then
        local targetHead = LockedTarget.Character:FindFirstChild("Head")
        local targetHum = LockedTarget.Character:FindFirstChildOfClass("Humanoid")
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if targetHead and targetHum and targetHum.Health > 0 and myRoot then
            -- Only lock camera if within reach to prevent snapping to people far away
            local dist = (targetHead.Position - myRoot.Position).Magnitude
            if dist <= LEGIT_REACH then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            end
        else
            LockedTarget = nil
            LockButton.Text = "Target Lock: OFF"
            LockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 150)
            LockEnabled = false
        end
    end
end)

