local function isAlive()
    if Workspace:GetAttribute("JugHold") == true then return false end
    local char = LocalPlayer.Character
    return Controller.state ~= nil and char ~= nil and char:GetAttribute("Alive") == true
end

local function isTargetAlive(target)
    if not target or not target.model then return false end
    if not target.model.Parent then return false end
    local alive = target.model:GetAttribute("Alive")
    if alive == false then return false end
    local hp = target.model:GetAttribute("Health")
    if type(hp) == "number" and hp <= 0 then return false end
    return true
end

local function isAirborne(state)
    if not state then return false end
    if state.onGround == false then return true end
    if state.vel and state.vel.Y and state.vel.Y > 0.1 then return true end
    return false
end

local function findHotbarSlot(pred)
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it and pred(it) then return i, it end
    end
    return nil, nil
end

local function getBestMaceSlot(fallDist)
    local anyMace, density, breach = nil, nil, nil
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it and it.id == "mace" then
            anyMace = anyMace or i
            if it.ench then
                if (it.ench.density or 0) > 0 or (it.ench.wind_burst or 0) > 0 then
                    density = density or i
                end
                if (it.ench.breach or 0) > 0 then
                    breach = breach or i
                end
            end
        end
    end
    if fallDist > 5.5 then
        return density or breach or anyMace
    end
    return breach or density or anyMace
end

local function findFireworkSlot()
    return findHotbarSlot(function(it)
        if not it.id then return false end
        local id = it.id:lower()
        return id == "firework_rocket" or id == "firework" or string.find(id, "firework") ~= nil
    end)
end

local function getBestAimPointAndAngles(eyePos, target)
    local width  = target.width  or Config.WIDTH
    local height = target.height or Config.HEIGHT
    local halfW  = (width * 0.5) * 0.80
    local minB = Vector3.new(target.feet.X - halfW, target.feet.Y + 0.08,       target.feet.Z - halfW)
    local maxB = Vector3.new(target.feet.X + halfW, target.feet.Y + height - 0.08, target.feet.Z + halfW)
    local closestPt = Vector3.new(
        math.clamp(eyePos.X, minB.X, maxB.X),
        math.clamp(eyePos.Y, minB.Y, maxB.Y),
        math.clamp(eyePos.Z, minB.Z, maxB.Z)
    )
    local centerPt = target.feet + Vector3.new(0, height * 0.5, 0)
    local aimPt    = closestPt:Lerp(centerPt, 0.25)
    local delta    = aimPt - eyePos
    if delta.Magnitude < 1e-5 then
        return Controller.look(), Controller.yaw, Controller.pitch
    end
    local u = delta.Unit
    local yaw   = math.atan2(-u.X, -u.Z)
    local pitch = math.asin(math.clamp(u.Y, -0.999, 0.999))
    return u, yaw, pitch
end

local function getClosestTarget(maxReach, fovDeg)
    local state = Controller.state
    local eye   = Controller.eye()
    if not state or not eye then return nil end
    local myLook  = Controller.look()
    local cosHalf = math.cos(math.rad((fovDeg or 360) * 0.5))
    local best, bestDist = nil, maxReach
    for _, t in ipairs(World.targets()) do
        local aimDir = getBestAimPointAndAngles(eye, t)
        if (fovDeg or 360) >= 359 or myLook:Dot(aimDir) >= cosHalf then
            local hitDist = origRayBox(eye, aimDir, t.feet, t.height, 0, t.width)
            if hitDist and hitDist <= bestDist then
                local wall = World.blockRay(eye, aimDir, hitDist, {"Solid"})
                if not wall or wall.dist >= hitDist then
                    best, bestDist = t, hitDist
                end
            end
        end
    end
    return best
end

local function swapChestArmor(wantElytra, hotbarOnly)
    local lastSwap = State._lastArmorSwap or 0
    if not isAlive() or Controller.tickCount - lastSwap < 5 then return false end

    local curChest    = Hands.inv.armor and Hands.inv.armor.chest
    local curIsElytra = curChest and curChest.id == "elytra"
    if wantElytra ~= nil and curIsElytra == wantElytra then return false end

    local targetSlot, where = nil, nil
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it then
            if wantElytra == true and it.id == "elytra" then
                targetSlot, where = i, "hotbar"; break
            elseif wantElytra == false then
                local def = Items.def(it)
                if def and def.kind == "armor" and def.slot == "chest" then
                    targetSlot, where = i, "hotbar"; break
                end
            end
        end
    end
    if not targetSlot and not hotbarOnly then
        for k, it in pairs(Hands.inv.inventory) do
            if type(k) == "number" and it then
                if wantElytra == true and it.id == "elytra" then
                    targetSlot, where = k + 10, "inventory"; break
                elseif wantElytra == false then
                    local def = Items.def(it)
                    if def and def.kind == "armor" and def.slot == "chest" then
                        targetSlot, where = k + 10, "inventory"; break
                    end
                end
            end
        end
    end
    if not targetSlot then return false end
    if hotbarOnly and where ~= "hotbar" then return false end

    State._lastArmorSwap = Controller.tickCount

    if where == "hotbar" and u116_queue then
        u116_queue.select = targetSlot
        u116_queue.uses   = (u116_queue.uses or 0) + 1
        return true
    else
        local wasOpen = false
        pcall(function() wasOpen = InventoryScreen.isOpen() end)
        if not wasOpen then Net.send({a = "inv", op = "open"}) end
        Net.send({a = "inv", op = "click", slot = targetSlot, shift = false, right = false})
        Net.send({a = "inv", op = "click", slot = 102,       shift = false, right = false})
        Net.send({a = "inv", op = "click", slot = targetSlot, shift = false, right = false})
        if not wasOpen then Net.send({a = "inv", op = "close"}) end
        return true
    end
end

local function queueNativeMaceSmash(target)
    if not isTargetAlive(target) then return false end
    local state = Controller.state
    local eye   = Controller.eye()
    if not state or not eye or not u116_queue then return false end

    local _, aimYaw, aimPitch = getBestAimPointAndAngles(eye, target)
    local maceSlot = getBestMaceSlot(state.fallDistance or 0)
    if not maceSlot then return false end

    State.SavedYaw   = State.SavedYaw   or Controller.yaw
    State.SavedPitch = State.SavedPitch or Controller.pitch
    Controller.yaw   = aimYaw
    Controller.pitch = aimPitch

    u116_queue.select = maceSlot
    u116_queue.attacks = 1
    if u224_targets then
        table.clear(u224_targets)
        table.insert(u224_targets, { look = Controller.look(), target = target })
    end
    return true
end

-- ▶ INSTANT locks (no smoothing)
local function snapLockTo(yaw, pitch)
    Controller.yaw   = yaw
    Controller.pitch = math.clamp(pitch, -1.52, 1.52)
end

local function lockYawToTarget()
    if not State.Target then return end
    local eye = Controller.eye()
    if not eye then return end
    local _, yaw = getBestAimPointAndAngles(eye, State.Target)
    Controller.yaw = yaw
end

local function pressJump()
    pcall(Input.setVirtual, "jump", true)
    State.JumpRel = Controller.tickCount + 1
end

local function stopCombo(msg)
    if State.SavedYaw then
        Controller.yaw = State.SavedYaw
        State.SavedYaw = nil
    end
    if State.SavedPitch then
        Controller.pitch = State.SavedPitch
        State.SavedPitch = nil
    end
    State.Active       = false
    State.Stage        = "idle"
    State.Target       = nil
    State.TargetName   = ""
    State.StageTick    = 0
    State.JumpRel      = nil
    State.Jump1Done    = false
    State.Jump2Done    = false
    State.Jump2At      = 0
    State.FireworkSlot = nil
    State.BobStart     = 0
    State.DownStart    = 0
    if msg then State.LastResult = msg end
    if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
end

local function startCombo()
    if State.Active then
        stopCombo("Cancelled")
        return
    end
    if not isAlive() then
        State.LastResult = "Not alive"
        if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
        return
    end
    if not u116_queue then
        State.LastResult = "Queue not found"
        if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
        return
    end
    if not getBestMaceSlot(10) then
        State.LastResult = "No mace in hotbar"
        if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
        return
    end

    State.Active       = true
    State.Stage        = "locking"
    State.Target       = nil
    State.TargetName   = ""
    State.StageTick    = 0
    State.SavedYaw     = Controller.yaw
    State.SavedPitch   = Controller.pitch
    State.LastResult   = ""
    State.Jump1Done    = false
    State.Jump2Done    = false
    State.Jump2At      = 0
    State.FireworkSlot = findFireworkSlot()
    State.BobStart     = 0
    State.DownStart    = 0
end

-------------------------------------------------------------------------------
-- Stage machine
-------------------------------------------------------------------------------
local function onPreTick(state)
    if State.JumpRel and Controller.tickCount >= State.JumpRel then
        pcall(Input.setVirtual, "jump", false)
        State.JumpRel = nil
    end

    if not State.Active then return end
    if not state or not isAlive() then stopCombo("Died") return end
    if not u116_queue then stopCombo("Queue lost") return end

    if State.Target and not isTargetAlive(State.Target) then
        stopCombo("Target died: " .. State.TargetName)
        return
    end

    -- Instant yaw snap every tick during jump & rocket
    if State.Target and (State.Stage == "jump" or State.Stage == "rocket") then
        lockYawToTarget()
    end

    State.StageTick = State.StageTick + 1
    local tick = State.StageTick

    -- ── LOCKING (instant — transitions in 1 tick) ────────────────────
    if State.Stage == "locking" then
        local target = getClosestTarget(CFG.Range, 360)
        if not target then
            if tick > 40 then stopCombo("No target") end
            return
        end
        State.Target     = target
        State.TargetName = tostring(target.model:GetAttribute("DisplayName") or target.model.Name)

        local eye = Controller.eye()
        if not eye then stopCombo("No eye") return end
        local _, yaw, pitch = getBestAimPointAndAngles(eye, target)
        snapLockTo(yaw, pitch)

        State.Stage     = "jump"
        State.StageTick = 0

    -- ── JUMP + AUTO FIREWORK ─────────────────────────────────────────
    elseif State.Stage == "jump" then
        if tick == 1 then
            if not swapChestArmor(true, true) then
                stopCombo("No elytra in hotbar")
                return
            end
            State.Jump1Done    = false
            State.Jump2Done    = false
            State.Jump2At      = 0
            State.FireworkSlot = findFireworkSlot()

        elseif tick >= 3 and tick <= 45 then
            if state.gliding then
                Controller.pitch = CFG.LookUpPitch
                if State.FireworkSlot then
                    u116_queue.select = State.FireworkSlot
                    State.Stage     = "rocket"
                    State.StageTick = 0
                else
                    State.Stage     = "dive"
                    State.StageTick = 0
                    State.BobStart  = os.clock()
                end
                return
            end

            if State.JumpRel then return end

            if not State.Jump1Done then
                local chest = Hands.inv.armor and Hands.inv.armor.chest
                if chest and chest.id == "elytra" and state.onGround then
                    pressJump()
                    State.Jump1Done = true
                end
            elseif not State.Jump2Done then
                if isAirborne(state) then
                    pressJump()
                    State.Jump2Done = true
                    State.Jump2At   = Controller.tickCount
                end
            else
                if isAirborne(state) and (Controller.tickCount - State.Jump2At) > 3 then
                    pressJump()
                    State.Jump2At = Controller.tickCount
                end
            end

        elseif tick > 45 then
            stopCombo("Failed to glide")
        end

    -- ── ROCKET ───────────────────────────────────────────────────────
    elseif State.Stage == "rocket" then
        if tick == 1 then
            Controller.pitch = CFG.LookUpPitch
            u116_queue.attacks = 0
            if u224_targets then table.clear(u224_targets) end
            u116_queue.uses = 1
            State.Stage     = "dive"
            State.StageTick = 0
            State.BobStart  = os.clock()
        end

    -- ── DIVE (instant bob — snaps up/down) ──────────────────────────
    elseif State.Stage == "dive" then
        local eye = Controller.eye()
        if not eye then stopCombo("No eye") return end

        local _, yaw = getBestAimPointAndAngles(eye, State.Target)
        local elapsed     = os.clock() - State.BobStart
        local phase       = math.floor(elapsed / CFG.BobDuration) % 2
        local targetPitch = (phase == 0) and CFG.LookUpPitch or CFG.LookDownPitch
        snapLockTo(yaw, targetPitch)

        if phase == 1 then
            if State.DownStart == 0 then
                State.DownStart = os.clock()
            end
        else
            State.DownStart = 0
        end

        local dist = (State.Target.feet - state.pos).Magnitude
        local swapNow = (phase == 1 and State.DownStart > 0
                         and (os.clock() - State.DownStart) >= CFG.DownSwapDelay)
                        or dist < CFG.DiveTrigger

        if swapNow then
            if swapChestArmor(false, true) then
                State.Stage     = "falling"
                State.StageTick = 0
            end
        elseif tick > 120 then
            stopCombo("Dive timeout")
        end

    -- ── FALLING (instant lock, smash at 1.5 studs) ──────────────────
    elseif State.Stage == "falling" then
        local eye = Controller.eye()
        if eye then
            local _, yaw, pitch = getBestAimPointAndAngles(eye, State.Target)
            snapLockTo(yaw, pitch)
        end

        if (state.fallDistance or 0) >= CFG.SmashFall and not state.gliding then
            State.Stage     = "smash"
            State.StageTick = 0
        elseif tick > 40 then
            stopCombo("Fall timeout")
        end

    -- ── SMASH ────────────────────────────────────────────────────────
    elseif State.Stage == "smash" then
        if queueNativeMaceSmash(State.Target) then
            State.Stage     = "recover"
            State.StageTick = 0
        else
            stopCombo("Smash failed")
        end

    -- ── RECOVER (instant snap back, 2 ticks) ────────────────────────
    elseif State.Stage == "recover" then
        if State.SavedYaw then
            Controller.yaw   = State.SavedYaw
            Controller.pitch = State.SavedPitch
        end
        if tick > 2 then
            stopCombo("Combo complete")
        end
    end

    if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
end

table.insert(Controller.beforeTick, 1, onPreTick)

