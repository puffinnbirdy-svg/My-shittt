GUI = {}
function GUI.UpdateStatus()
    local stage = State.Stage
    if stage == "locking" then
        StageLbl.Text = "Locking target..."
    elseif stage == "jump" then
        StageLbl.Text = "Equipping elytra + jumping"
    elseif stage == "rocket" then
        StageLbl.Text = "FIRING FIREWORK"
    elseif stage == "dive" then
        local elapsed = os.clock() - State.BobStart
        local phase   = math.floor(elapsed / CFG.BobDuration) % 2
        if phase == 0 then
            StageLbl.Text = "Climbing  ↑ looking up"
        else
            local wait = State.DownStart > 0
                and (CFG.DownSwapDelay - (os.clock() - State.DownStart))
                or CFG.DownSwapDelay
            StageLbl.Text = string.format("Committing  ↓  (%.1fs)", math.max(0, wait))
        end
    elseif stage == "falling" then
        StageLbl.Text = "Falling (awaiting smash)"
    elseif stage == "smash" then
        StageLbl.Text = "MACE SMASH"
    elseif stage == "recover" then
        StageLbl.Text = "Finishing"
    else
        StageLbl.Text = "Idle"
    end
    StageLbl.TextColor3 = State.Active and Accent or Fg

    if State.LastResult ~= "" then
        SubLbl.Text = State.LastResult
        SubLbl.TextColor3 = State.Active and Warn or Dim
    elseif State.Active and State.TargetName ~= "" then
        SubLbl.Text = "Target: " .. State.TargetName
        SubLbl.TextColor3 = Dim
    else
        SubLbl.Text = State.Active and "Combo running..." or "R to start • Y to cancel"
        SubLbl.TextColor3 = Dim
    end

    StartBtn.Text = State.Active and "CANCEL  (Y)" or "START  (R)"
    StartBtn.BackgroundColor3 = State.Active and Warn or Accent
end

StartBtn.MouseButton1Click:Connect(startCombo)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe and UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == CFG.Keybind then
        startCombo()
    elseif input.KeyCode == CFG.CancelKey then
        if State.Active then stopCombo("Cancelled") end
    end
end)

