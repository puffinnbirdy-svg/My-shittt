GUI = {}
function GUI.UpdateStatus()
    local stage = State.Stage
    if not State.Active then
        StageLbl.Text = "Ready"
        StageLbl.TextColor3 = Fg
    else
        StageLbl.TextColor3 = Accent
        if stage == "idle" then
            StageLbl.Text = "Searching..."
        elseif stage == "wc_equip" then
            StageLbl.Text = "Wind charge"
        elseif stage == "wc_wait" then
            StageLbl.Text = "Wind charge launched"
        elseif stage == "spear_equip" then
            StageLbl.Text = "Equipping Spear"
        elseif stage == "spear_wait" then
            StageLbl.Text = "Spear Lunged"
        elseif stage == "mace_equip" then
            StageLbl.Text = "Mace Equipped"
        elseif stage == "mace_attack" then
            StageLbl.Text = "Auto Attack (1.0s)"
        end
    end

    if State.LastResult ~= "" then
        SubLbl.Text = State.LastResult
        SubLbl.TextColor3 = (State.LastResult == "Combo complete" or State.LastResult == "Cancelled") and Good or Warn
    else
        SubLbl.Text = State.Active and "Running…" or "G to start"
        SubLbl.TextColor3 = Dim
    end

    if State.TargetName ~= "" and State.Active then
        TargetLbl.Text = "Target: " .. State.TargetName
    else
        TargetLbl.Text = ""
    end

    if State.Active then
        StartBtn.Text = "STOP COMBO  [G]"
        StartBtn.BackgroundColor3 = Red
        StartBtn.TextColor3 = Fg
    else
        StartBtn.Text = "START COMBO  [G]"
        StartBtn.BackgroundColor3 = Accent
        StartBtn.TextColor3 = Color3.fromRGB(15, 15, 20)
    end
end

StartBtn.MouseButton1Click:Connect(startCombo)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == CFG.ActivateKey then
        startCombo()
    end
end)

