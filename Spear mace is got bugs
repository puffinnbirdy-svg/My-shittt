-------------------------------------------------------------------------------
-- Unwrap originals
-------------------------------------------------------------------------------
local origRayBox = World.rayBox
pcall(function()
    for _ = 1, 5 do
        if debug.info(World.rayBox, "s") == "" then
            for i = 1, 5 do
                local ok, upv = pcall(debug.getupvalue, World.rayBox, i)
                if ok and type(upv) == "function" then
                    World.rayBox = upv
                    break
                end
            end
        else
            break
        end
    end
end)
origRayBox = World.rayBox

-------------------------------------------------------------------------------
-- Queue extraction
-------------------------------------------------------------------------------
local u116_queue, u224_targets = nil, nil
local noteSwapFn = nil
pcall(function()
    local okNs, ns = pcall(debug.getupvalue, Hands.select, 2)
    if okNs and type(ns) == "function" then
        noteSwapFn = ns
    end
    for _, btFn in ipairs(Controller.beforeTick) do
        if type(btFn) == "function" and debug.info(btFn, "s"):find("Hands") then
            local ok1, q = pcall(debug.getupvalue, btFn, 1)
            if ok1 and type(q) == "table" and q.attacks ~= nil then
                u116_queue = q
                local ok6, attackFn = pcall(debug.getupvalue, btFn, 6)
                if ok6 and type(attackFn) == "function" then
                    local okT, tQueue = pcall(debug.getupvalue, attackFn, 1)
                    if okT and type(tQueue) == "table" then
                        u224_targets = tQueue
                    end
                end
                break
            end
        end
    end
end)

