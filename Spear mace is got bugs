-------------------------------------------------------------------------------
-- Helpers
-------------------------------------------------------------------------------
local function isAlive()
    if Workspace:GetAttribute("JugHold") == true then return false end
    local char = LocalPlayer.Character
    return Controller.state ~= nil and char ~= nil and char:GetAttribute("Alive") == true
end

local function isTargetAlive(target)
    if not target or not target.model then return false end
    if not target.model.Parent then return false end
    local alive = target.model:GetAttribute("Alive")
    if alive == false then return false end
    local hp = target.model:GetAttribute("Health")
    if type(hp) == "number" and hp <= 0 then return false end
    return true
end

local function findLiveTarget(model)
    if not model or not model.Parent then return nil end
    for _, t in ipairs(World.targets()) do
        if t.model == model then return t end
    end
    return nil
end

local function findHotbarSlot(pred)
    for i = 1, 9 do
        local it = Hands.inv.hotbar[i]
        if it and pred(it) then return i, it end
    end
    return nil, nil
end

local function findWindChargeSlot()
    return findHotbarSlot(function(it) return it.id == "wind_charge" end)
end

local function getAnySpearSlot()
    return findHotbarSlot(function(it)
        local def = Items.def(it)
        return def and def.kind == "spear"
    end)
end

local function getBestMaceSlot(fallDist)
    local densitySlot, breachSlot, anyMaceSlot = nil, nil, nil
    for i = 1, 9 do
        local item = Hands.inv.hotbar[i]
        if item and item.id == "mace" then
            anyMaceSlot = anyMaceSlot or i
            if item.ench then
                if (item.ench.density or 0) > 0 or (item.ench.wind_burst or 0) > 0 then
                    densitySlot = densitySlot or i
                end
                if (item.ench.breach or 0) > 0 then
                    breachSlot = breachSlot or i
                end
            end
        end
    end
    if CFG.MaceDualSmart then
        if fallDist > 5.5 and densitySlot then return densitySlot end
        if breachSlot and fallDist <= 5.5 then return breachSlot end
    end
    return densitySlot or breachSlot or anyMaceSlot
end

local function getBestSwordSlot()
    return (findHotbarSlot(function(it)
        local def = Items.def(it)
        return def and def.kind == "sword"
    end))
end

local function getBestAxeSlot()
    return (findHotbarSlot(function(it)
        local def = Items.def(it)
        return def and def.disablesShield == true
    end))
end

local function getTargetHurtRemaining(target)
    if not target or not target.model then return 0 end
    local eid = target.model:GetAttribute("EntityId")
    if eid == nil then return 0 end
    return (enemyHurtTicks[eid] or 0) - Controller.tickCount
end

local function getEffectiveAttackStrength()
    if noteSwapFn then
        local ok1, u95 = pcall(debug.getupvalue, noteSwapFn, 1)
        local ok3, u96 = pcall(debug.getupvalue, noteSwapFn, 3)
        if ok1 and ok3 and type(u96) == "table" and (Controller.tickCount - (tonumber(u95) or -99)) <= 1 then
            local def = u96.item and Items.def(u96.item)
            return Combat.strength(Controller.tickCount - (u96.reset or 0), def and def.speed or 4)
        end
    end
    return Hands.strength(0)
end

local function isTargetShieldingFrom(eyePos, target)
    local model = target.model
    if model and model:GetAttribute("Using") == "shield" and model.PrimaryPart then
        local toAttacker = eyePos * BLOCK - model.PrimaryPart.Position
        local look = model.PrimaryPart.CFrame.LookVector
        if Vector3.new(toAttacker.X, 0, toAttacker.Z):Dot(Vector3.new(look.X, 0, look.Z)) > 0 then
            return true
        end
    end
    return false
end

local function getBestAimPointAndAngles(eyePos, target)
    local width  = target.width  or Config.WIDTH
    local height = target.height or Config.HEIGHT
    local halfW  = (width * 0.5) * 0.80
    local minB = Vector3.new(target.feet.X - halfW, target.feet.Y + 0.08, target.feet.Z - halfW)
    local maxB = Vector3.new(target.feet.X + halfW, target.feet.Y + height - 0.08, target.feet.Z + halfW)
    local closestPt = Vector3.new(
        math.clamp(eyePos.X, minB.X, maxB.X),
        math.clamp(eyePos.Y, minB.Y, maxB.Y),
        math.clamp(eyePos.Z, minB.Z, maxB.Z)
    )
    local centerPt = target.feet + Vector3.new(0, height * 0.5, 0)
    local aimPt    = closestPt:Lerp(centerPt, 0.25)
    local delta    = aimPt - eyePos
    if delta.Magnitude < 1e-5 then return Controller.look(), Controller.yaw, Controller.pitch end
    local u = delta.Unit
    local yaw   = math.atan2(-u.X, -u.Z)
    local pitch = math.asin(math.clamp(u.Y, -0.999, 0.999))
    return u, yaw, pitch
end

local function getClosestTarget(maxReach, fovDeg)
    local state = Controller.state
    local eye   = Controller.eye()
    if not state or not eye then return nil end
    local myLook  = Controller.look()
    local cosHalf = math.cos(math.rad((fovDeg or 360) * 0.5))
    local best, bestDist = nil, maxReach

    for _, t in ipairs(World.targets()) do
        local isDummy = (World.folder and World.folder.Dummies and t.model.Parent == World.folder.Dummies)
        if not CFG.TargetDummies and isDummy then
            continue
        end

        local aimDir = getBestAimPointAndAngles(eye, t)
        if (fovDeg or 360) >= 359 or myLook:Dot(aimDir) >= cosHalf then
            local hitDist = origRayBox(eye, aimDir, t.feet, t.height, 0, t.width)
            if hitDist and hitDist <= bestDist then
                local wall = World.blockRay(eye, aimDir, hitDist, {"Solid"})
                local web = World.blockRay(eye, aimDir, 4.5, {"Webs"})
                local webBlocked = (web ~= nil and web.dist <= hitDist)
                if (not wall or wall.dist >= hitDist) and not webBlocked then
                    best, bestDist = t, hitDist
                end
            end
        end
    end
    return best
end

local function saveCamera()
    if State.SavedYaw == nil then
        State.SavedYaw   = Controller.yaw
        State.SavedPitch = Controller.pitch
    end
end

local function restoreCamera()
    if State.SavedYaw ~= nil then
        Controller.yaw   = State.SavedYaw
        Controller.pitch = State.SavedPitch
        State.SavedYaw   = nil
        State.SavedPitch = nil
    end
end

local function stopCombo(msg)
    restoreCamera()
    State.Active      = false
    State.Stage       = "idle"
    State.StageTick   = 0
    State.Target      = nil
    State.TargetName  = ""
    State.LastDist    = math.huge
    if msg then
        State.LastResult = msg
        log("Stopped: " .. msg)
    end
    if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
end

-------------------------------------------------------------------------------
-- Native attack queue
-------------------------------------------------------------------------------
local function queueNativeAttack(target, forceMaceSmash, noSilentRotate)
    local state = Controller.state
    local eye = Controller.eye()
    if not state or not eye or not target or not u116_queue then return false end
    if not forceMaceSmash and Hands.using and Hands.using.kind == "eat" then return false end

    if forceMaceSmash then
        if Controller.tickCount - lastMaceSmashTick < 6 then return false end
    else
        if Controller.tickCount - lastAutoAttackTick < 3 then return false end
    end

    local aimLook, aimYaw, aimPitch = Controller.look(), Controller.yaw, Controller.pitch
    if not noSilentRotate and (CFG.MaceSilentAim) then
        aimLook, aimYaw, aimPitch = getBestAimPointAndAngles(eye, target)
    end

    local shielded = isTargetShieldingFrom(eye, target)
    if not forceMaceSmash and not shielded and CFG.SwordIFrameSync then
        if getTargetHurtRemaining(target) > 0 then return false end
    end

    local origSlot = Hands.inv.selected
    local chosenSlot = origSlot
    local origHeld = Hands.held()
    local origDef = origHeld and Items.def(origHeld)
    local usedBreachSwap = false

    if shielded and CFG.AutoShieldBreak then
        local axeSlot = getBestAxeSlot()
        if axeSlot then chosenSlot = axeSlot end
    elseif forceMaceSmash then
        local effFall = CFG.MaceFallSpoof and math.max(state.fallDistance, CFG.MaceSpoofHeight) or state.fallDistance
        local maceSlot = getBestMaceSlot(effFall)
        if maceSlot then chosenSlot = maceSlot end
    end

    if Hands.using and Hands.using.kind == "shield" then
        pcall(Hands.stopUsing, false)
    end

    if not forceMaceSmash then
        local effCharge = getEffectiveAttackStrength()
        if effCharge < (tonumber(CFG.KillAuraMinCharge) or 0.90) then return false end
    end

    if chosenSlot ~= origSlot then
        u116_queue.select = chosenSlot
        if usedBreachSwap then
            pendingRestoreSlot = origSlot
            pendingRestoreTick = Controller.tickCount + 1
        elseif forceMaceSmash and CFG.MaceAutoReturnSword then
            pendingRestoreSlot = getBestSwordSlot() or origSlot
            pendingRestoreTick = Controller.tickCount + 1
        elseif shielded and CFG.AutoShieldBreak then
            pendingRestoreSlot = getBestSwordSlot() or origSlot
            pendingRestoreTick = Controller.tickCount + 1
        end
        -- Only skip the attack tick when 1-tick-swap is explicitly disabled
        if forceMaceSmash and not CFG.Mace1TickSwap then
            return true
        end
    end

    -- Apply fall spoof unconditionally for mace smash
    if forceMaceSmash and CFG.MaceFallSpoof then
        state.fallDistance = math.max(state.fallDistance, CFG.MaceSpoofHeight)
        state.onGround = false
        state.gliding = false
    end

    if not noSilentRotate and (CFG.MaceSilentAim) then
        if savedYaw == nil then
            savedYaw = Controller.yaw
            savedPitch = Controller.pitch
        end
        Controller.yaw = aimYaw
        Controller.pitch = aimPitch
    end

    u116_queue.attacks = 1
    if u224_targets then
        table.clear(u224_targets)
        table.insert(u224_targets, { look = Controller.look(), target = target })
    end

    recordLMB()
    lastSwordTarget = target
    lastSwordTargetAt = os.clock()
    lastAutoAttackTick = Controller.tickCount
    if forceMaceSmash then lastMaceSmashTick = Controller.tickCount end
    return true
end

-------------------------------------------------------------------------------
-- Combo state machine
-------------------------------------------------------------------------------
local function onPreTick(state)
    if State.JumpReleaseTick and Controller.tickCount >= State.JumpReleaseTick then
        pcall(Input.setVirtual, "jump", false)
        State.JumpReleaseTick = nil
    end

    if not State.Active then return end
    if not u116_queue then stopCombo("Queue lost") return end
    if not state or not isAlive() then stopCombo("Not alive") return end

    if pendingRestoreSlot and Controller.tickCount >= pendingRestoreTick and u116_queue then
        if not u116_queue.select and Hands.inv.selected ~= pendingRestoreSlot then
            u116_queue.select = pendingRestoreSlot
        end
        pendingRestoreSlot = nil
    end

    State.StageTick = State.StageTick + 1
    local tick = State.StageTick

    if State.Stage == "idle" then
        local target = getClosestTarget(CFG.Range, 360)
        if not target then
            stopCombo("No target found")
            return
        end
        State.Target      = target
        State.TargetName  = tostring(target.model:GetAttribute("DisplayName") or target.model.Name)
        State.LastResult  = ""
        saveCamera()
        State.Stage       = "wc_equip"
        State.StageTick   = 0
        log("Target acquired: " .. State.TargetName)

    elseif State.Stage == "wc_equip" then
        local wcSlot = findWindChargeSlot()
        if not wcSlot then stopCombo("No wind charge") return end
        local cd = Hands.cooldownFraction("wind_charge")
        if cd and cd > 0 then
            if tick > 60 then stopCombo("WC cooldown timeout") end
            return
        end

        if state.onGround then
            pcall(Input.setVirtual, "jump", true)
            State.JumpReleaseTick = Controller.tickCount + 1
        end

        u116_queue.select  = wcSlot
        Controller.pitch   = CFG.LookDownPitch
        u116_queue.attacks = 0
        if u224_targets then table.clear(u224_targets) end
        u116_queue.uses    = 1
        State.Stage        = "wc_wait"
        State.StageTick    = 0
        log("Used wind charge")

    elseif State.Stage == "wc_wait" then
        if not State.Target or not isTargetAlive(State.Target) then
            stopCombo("Target died") return
        end
        if tick >= CFG.WcWaitTicks then
            State.Stage     = "spear_equip"
            State.StageTick = 0
        end

    elseif State.Stage == "spear_equip" then
        if not State.Target or not isTargetAlive(State.Target) then
            stopCombo("Target died") return
        end
        local live = findLiveTarget(State.Target.model)
        if live then State.Target = live end

        local spearSlot = getAnySpearSlot()
        if not spearSlot then stopCombo("No spear") return end

        if getEffectiveAttackStrength() < 1 then
            if tick > 60 then stopCombo("Spear cooldown timeout") end
            return
        end

        if Hands.using and Hands.using.kind == "shield" then
            pcall(Hands.stopUsing, false)
        end

        local eye = Controller.eye()
        if eye then
            local _, aimYaw, aimPitch = getBestAimPointAndAngles(eye, State.Target)
            Controller.yaw = aimYaw
            Controller.pitch = aimPitch
        end

        u116_queue.select  = spearSlot
        u116_queue.attacks = 1
        if u224_targets then
            table.clear(u224_targets)
            table.insert(u224_targets, { look = Controller.look(), target = State.Target })
        end
        State.Stage     = "spear_wait"
        State.StageTick = 0
        log("Lunged with spear")

    elseif State.Stage == "spear_wait" then
        if not State.Target or not isTargetAlive(State.Target) then
            stopCombo("Target died") return
        end
        local eye = Controller.eye()
        if eye then
            local _, aimYaw, aimPitch = getBestAimPointAndAngles(eye, State.Target)
            Controller.yaw = aimYaw
            Controller.pitch = aimPitch
        end
        if tick >= CFG.SpearWaitTicks then
            State.Stage     = "mace_equip"
            State.StageTick = 0
        end

    elseif State.Stage == "mace_equip" then
        local maceSlot = getBestMaceSlot(state.fallDistance or 0)
        if not maceSlot then stopCombo("No mace") return end
        u116_queue.select    = maceSlot
        State.Stage          = "mace_attack"
        State.StageTick      = 0
        State.LastAttackTick = 0
        log("Equipped mace, starting auto-attack loop")

    elseif State.Stage == "mace_attack" then
        if not State.Target or not isTargetAlive(State.Target) then
            stopCombo("Target died") return
        end
        local live = findLiveTarget(State.Target.model)
        if live then State.Target = live end

        -- Lock camera
        local eye = Controller.eye()
        if eye then
            local _, aimYaw, aimPitch = getBestAimPointAndAngles(eye, State.Target)
            Controller.yaw = aimYaw
            Controller.pitch = aimPitch
        end

        -- Auto-attack exactly every 1.0 seconds (20 ticks @ 20 TPS)
        if Controller.tickCount - State.LastAttackTick >= (CFG.AttackInterval or 20) then
            if queueNativeAttack(State.Target, true, false) then
                State.LastAttackTick = Controller.tickCount
                log("Mace auto-attack fired")
            end
        end
    end

    if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
end

local function onPostTick(state)
    if savedYaw ~= nil and savedPitch ~= nil then
        Controller.yaw = savedYaw
        Controller.pitch = savedPitch
        savedYaw = nil
        savedPitch = nil
    end
end

-- Clean up previous instance
if _G.__SPEAR_MACE_LAST then
    local prev = _G.__SPEAR_MACE_LAST
    pcall(function()
        for i = #Controller.beforeTick, 1, -1 do
            if Controller.beforeTick[i] == prev.onPreTick then
                table.remove(Controller.beforeTick, i)
            end
        end
        for i = #Controller.onTick, 1, -1 do
            if Controller.onTick[i] == prev.onPostTick then
                table.remove(Controller.onTick, i)
            end
        end
    end)
    pcall(function() if prev.gui then prev.gui:Destroy() end end)
end
_G.__SPEAR_MACE_LAST = { onPreTick = onPreTick, onPostTick = onPostTick }
table.insert(Controller.beforeTick, 1, onPreTick)
table.insert(Controller.onTick, onPostTick)

-------------------------------------------------------------------------------
-- Action / Start function
-------------------------------------------------------------------------------
local function startCombo()
    if State.Active then
        stopCombo("Cancelled")
        return
    end

    if not u116_queue then State.LastResult = "Queue not found" return end
    if not findWindChargeSlot() then State.LastResult = "No wind charge in hotbar" return end
    if not getAnySpearSlot() then State.LastResult = "No spear in hotbar" return end
    if not getBestMaceSlot(0) then State.LastResult = "No mace in hotbar" return end

    State.Active        = true
    State.Stage         = "idle"
    State.StageTick     = 0
    State.LastResult    = "Searching..."
    log("Combo Started")
    if GUI and GUI.UpdateStatus then GUI.UpdateStatus() end
end

