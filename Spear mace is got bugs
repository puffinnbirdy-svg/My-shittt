local rangeDrag = false
local function setRange(v)
    v = math.clamp(v, 5, 80)
    CFG.Range = v
    RangeFill.Size = UDim2.new((v - 5) / 75, 0, 1, 0)
    RangeVal.Text = string.format("%d", v)
end
RangeTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rangeDrag = true
        setRange(5 + ((input.Position.X - RangeTrack.AbsolutePosition.X) / RangeTrack.AbsoluteSize.X) * 75)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if rangeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        setRange(5 + ((input.Position.X - RangeTrack.AbsolutePosition.X) / RangeTrack.AbsoluteSize.X) * 75)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rangeDrag = false
    end
end)

